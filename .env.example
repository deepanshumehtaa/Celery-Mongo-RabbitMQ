# Celery / RabbitMQ Configuration
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
BROKER_CONNECTION_RETRY_ON_STARTUP=true
BROKER_POOL_LIMIT=10
BROKER_HEARTBEAT=60

# RabbitMQ Priority Queue Names
QUEUE_HIGH_PRIORITY=high_priority
QUEUE_DEFAULT=default
QUEUE_LOW_PRIORITY=low_priority

# MongoDB Configuration
MONGO_URI=mongodb://admin:admin_password@localhost:27017/
MONGO_DB_NAME=celery_tasks
MONGO_LOGS_COLLECTION=task_logs
MONGO_RESPONSES_COLLECTION=task_responses
MONGO_LOCKS_COLLECTION=task_locks

# Lock settings (5 minutes default timeout)
MONGO_LOCK_TIMEOUT_SECONDS=300
